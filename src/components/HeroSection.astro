---
import GradientText from './GradientText.astro'
import { useTranslations } from '../i18n/utils'

const t = useTranslations(Astro.currentLocale)
---

<section class="w-full lg:w-1/2 space-y-8" data-parallax-speed="1">
    <div class="chip-soft">
        <span class="relative flex h-2 w-2">
            <span
                class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"
            ></span>
        </span>
        {t.hero.status}
    </div>

    <div class="space-y-2">
        <h2
            class="hero-line text-4xl font-light tracking-tight text-content md:text-5xl lg:text-6xl"
        >
            {t.hero.hello}
            <span class="serif-font italic font-semibold text-accent"
                >{t.hero.name}</span
            >
        </h2>
        <h1
            class="hero-line text-6xl font-black leading-[0.9] tracking-tighter text-foreground md:text-7xl lg:text-8xl"
        >
            {t.hero.roleTop}
            <br />
            <GradientText className="inline-block">
                {t.hero.roleBottom}
            </GradientText>
        </h1>
    </div>

    <div class="glass-panel max-w-lg border-l-4 border-l-accent p-6">
        <p class="text-lg leading-relaxed text-muted">
            {t.hero.description}
        </p>
    </div>

    <div class="flex flex-wrap items-center gap-4 pt-2">
        <a href="#projects" data-goto-section="projects" class="btn-primary">
            {t.hero.viewWork}
            <span aria-hidden="true">→</span>
        </a>
        <a href="#contact" data-goto-section="contact" class="btn-secondary">
            {t.hero.getInTouch}
        </a>
    </div>

    <div class="flex items-center gap-3 pt-3 text-muted">
        <span class="h-px w-12 bg-border-soft"></span>
        <a
            href="https://github.com/Tomato1337"
            target="_blank"
            rel="noreferrer"
            aria-label="GitHub"
            class="inline-flex rounded-full p-2 transition-colors hover:bg-surface hover:text-content"
        >
            <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <path
                    d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7a5.44 5.44 0 0 0-1.5-3.77 5.07 5.07 0 0 0-.09-3.77s-1.18-.35-3.91 1.48a13.38 13.38 0 0 0-7 0C6.27.63 5.09.98 5.09.98A5.07 5.07 0 0 0 5 4.75a5.44 5.44 0 0 0-1.5 3.77c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
                ></path>
            </svg>
        </a>

        <a
            href="https://t.me/Tomato1337"
            target="_blank"
            rel="noreferrer"
            aria-label="Telegram"
            class="inline-flex items-center justify-center rounded-full p-2 transition-colors hover:bg-surface hover:text-content"
        >
            <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <path d="M22 2 11 13"></path>
                <path d="M22 2 15 22l-4-9-9-4Z"></path>
            </svg>
        </a>
    </div>
</section>
