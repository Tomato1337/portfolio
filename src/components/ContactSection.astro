---
import { useTranslations } from '../i18n/utils'

const t = useTranslations(Astro.currentLocale)
---

<section id="contact" class="fullpage-section">
    <div class="fp-outer">
        <div class="fp-inner">
            <div class="fp-bg items-start">
                <div
                    class="section-shell flex min-h-full w-full flex-col pt-32 pb-10"
                >
                    <div class="grid flex-1 items-center gap-12 lg:grid-cols-2">
                        <div class="space-y-4 reveal">
                            <p
                                class="mono-font text-sm font-semibold tracking-wide text-accent"
                            >
                                ssh connect @tomato1337
                            </p>
                            <h2
                                class="text-4xl font-black tracking-tight text-foreground md:text-5xl"
                            >
                                {t.contact.heading}
                            </h2>
                            <p
                                class="max-w-lg text-lg leading-relaxed text-muted"
                            >
                                {t.contact.description}
                            </p>
                        </div>

                        <div class="glass-panel reveal space-y-4 p-7">
                            <a
                                class="btn-secondary w-full justify-center"
                                href="mailto:job@tomato1337.site"
                                >Email: job@tomato1337.site</a
                            >
                            <a
                                class="btn-secondary w-full justify-center"
                                href="https://t.me/shial1337"
                                target="_blank">Telegram: @shial1337</a
                            >
                            <a
                                class="btn-primary w-full justify-center"
                                href="https://github.com/Tomato1337"
                                target="_blank">{t.contact.openGithub}</a
                            >
                        </div>
                    </div>

                    <footer>
                        <div
                            class="glass-panel flex items-center justify-between px-5 py-3 text-xs mono-font text-muted"
                        >
                            <span class="inline-flex items-center gap-2"
                                ><span class="h-2 w-2 rounded-full bg-success"
                                ></span>v1.0.0</span
                            >
                            <span>branch: main/portfolio</span>
                        </div>
                    </footer>
                </div>
            </div>
        </div>
    </div>
</section>
